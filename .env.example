# Set SITE_URL=https://www.martheogdeivi.no on Vercel. Use localhost during development.
SITE_URL=http://127.0.0.1:3000
# Required when using Supabase or deploying to Vercel. Keep it private.
ADMIN_PASSWORD=
# Supabase project URL and server-only Secret key (sb_secret_...).
# Run supabase/wedding-schema.sql before connecting. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Optional public key, used only by db:check to verify access is denied to guests.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Without Supabase credentials, local development uses SQLite. Vercel requires Supabase.
# Optional directory for the local SQLite fallback; default .local-data in this project.
# WEDDING_DATA_DIR=
